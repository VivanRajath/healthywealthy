{
  // Static site: `npm run build` exports to ./out and Workers serves it as static assets.
  // Only /api/* runs the Worker (live market data); every other request goes straight to the files.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "healthywealthy",
  "compatibility_date": "2026-11-13",
  "main": "worker/index.js",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page"
  },
  // Custom domains are attached on every deploy. DNS and SSL are created by Cloudflare.
  "routes": [
    { "pattern": "healthywealthy.club", "custom_domain": true },
    { "pattern": "www.healthywealthy.club", "custom_domain": true }
  ]
}
